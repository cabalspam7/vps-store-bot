# ============================================================
# Telegram
# ============================================================
# Token dari @BotFather
BOT_TOKEN=123456:ABCdefGhIJKlmNoPQRsTUVwxyZ
# ID Telegram-mu (cari lewat @userinfobot). Bisa beberapa, pisah koma.
ADMIN_IDS=123456789
STORE_NAME=RVX VPS
SUPPORT_CONTACT=@username_kamu

# ============================================================
# Pembayaran (Pakasir QRIS, mode produksi)
# ============================================================
PAKASIR_BASE_URL=https://app.pakasir.com
PAKASIR_PROJECT=slug-project-kamu
PAKASIR_API_KEY=api-key-kamu

# Order otomatis kedaluwarsa kalau tidak dibayar (menit)
ORDER_EXPIRE_MINUTES=35
# Jeda pengecekan pembayaran & expiry (detik)
CHECK_INTERVAL_SECONDS=15
# 0 = webhook mati, pembayaran dicek lewat polling saja (paling gampang).
# Isi port (misal 8080) kalau mau webhook Pakasir sebagai jalur cepat.
WEBHOOK_PORT=0

# ============================================================
# Siklus layanan
# ============================================================
# Berapa hari data disimpan setelah VPS distop karena expired
GRACE_DAYS=3
# true = hapus VPS otomatis setelah masa tenggang habis
# false = VPS tetap mati tapi tidak pernah dihapus otomatis
AUTO_DESTROY=true
MAX_PROVISION_ATTEMPTS=3

# ============================================================
# Provider
# ============================================================
# mock    = simulasi, tidak menyentuh server sungguhan. PAKAI INI DULU.
# proxmox = Proxmox VE
PROVIDER=mock

PROXMOX_HOST=https://ip-proxmox-kamu:8006
PROXMOX_NODE=pve
# Format: user@realm!tokenid=uuid
PROXMOX_TOKEN=root@pam!botvps=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# false kalau Proxmox pakai sertifikat self-signed (default)
PROXMOX_VERIFY_SSL=false
# qemu (VM, direkomendasikan) atau lxc (container)
PROXMOX_KIND=qemu
PROXMOX_STORAGE=local-lvm
PROXMOX_DISK=scsi0
PROXMOX_BRIDGE=vmbr0
PROXMOX_FULL_CLONE=true
PROXMOX_TASK_TIMEOUT=300

# ============================================================
# Jaringan VPS
# ============================================================
# pool = bot yang menentukan IP dari daftar di bawah (disarankan)
# dhcp = VPS ambil IP sendiri, bot tanya ke qemu-guest-agent
IP_MODE=pool
IP_POOL=203.0.113.10,203.0.113.11,203.0.113.12
PROXMOX_GATEWAY=203.0.113.1
PROXMOX_NETMASK=24

VM_USER=root
SSH_PORT=22

# ============================================================
# Penyimpanan
# ============================================================
DB_PATH=data/vps.db
MOCK_STATE_PATH=data/mock_provider.json
